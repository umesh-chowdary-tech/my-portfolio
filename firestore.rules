rules_version = '2';

// Visitors can read testimonials and add new ones, but nobody can edit or
// delete them from the website. Remove unwanted entries in the Firebase console.
// Keep the length limits in sync with MAX_LENGTH in src/components/Testimonials.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function isShortText(value, max) {
      return value is string && value.size() <= max;
    }

    function isValidTestimonial(data) {
      return data.keys().hasOnly(['name', 'role', 'company', 'text', 'rating', 'createdAt'])
        && data.keys().hasAll(['name', 'role', 'company', 'text', 'rating', 'createdAt'])
        && isShortText(data.name, 60) && data.name.size() > 0
        && isShortText(data.role, 60)
        && isShortText(data.company, 60)
        && isShortText(data.text, 1000) && data.text.size() > 0
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.createdAt == request.time;
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isValidTestimonial(request.resource.data);
      allow update, delete: if false;
    }
  }
}
